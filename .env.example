# =================================================  
# LISTA DE COMPRAS - Variaveis de ambiente  
# Copie este ficheiro para .env e preencha os valores  
# NUNCA commite o .env com valores reais  
# =================================================  
  
# Supabase (publico - injetado pelo Vite no bundle do cliente)  
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co  
VITE_SUPABASE_ANON_KEY=  
  
# Supabase (servidor - NUNCA expor ao cliente)  
SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co  
SUPABASE_SERVICE_ROLE_KEY=  
  
# Gate de autenticacao (single-user, username+password)  
SESSION_SECRET=gere-uma-string-aleatoria-longa-aqui  
SITE_USERNAME=  
SITE_PASSWORD=  
  
# Bypass do login em desenvolvimento local  
# Definir como false em producao  
